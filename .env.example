# Copy this file to .env (or .env.local) and adjust.

# ---------------------------------------------------------------
# Public address of the app. Used to build the links in emails.
# Dev: http://localhost:3000   Production: e.g. https://cto.ict.gov.tt
# ---------------------------------------------------------------
APP_URL=http://localhost:3000

# ---------------------------------------------------------------
# Mail relay (outgoing only, no authentication)
# ---------------------------------------------------------------
SMTP_HOST=mailrelay.gov.tt
SMTP_PORT=25
# Port 25 is plain SMTP. Leave SECURE=false; STARTTLS is used if the relay offers it.
SMTP_SECURE=false
# Set to true if the relay advertises STARTTLS but the handshake fails.
SMTP_IGNORE_TLS=false
# Set to false if the relay uses a self-signed / internal certificate for STARTTLS.
SMTP_TLS_REJECT_UNAUTHORIZED=true
# How long to wait for the relay before falling back to the outbox (ms).
SMTP_CONNECTION_TIMEOUT_MS=8000

# The "From" address. The relay may only accept certain sender domains.
MAIL_FROM="ICT Services - CTO Requests <cto-requests@gov.tt>"

# auto   = try the relay, save to the outbox and retry later if it can't be reached (default)
# smtp   = same as auto (kept for clarity in production configs)
# outbox = never contact the relay; every email is saved to the outbox only (pure dev mode)
MAIL_MODE=auto

# Optional: send EVERY email to this address instead of the real recipients (for testing).
# The original recipients are shown at the top of the email. Leave empty in production.
MAIL_REDIRECT_TO=

# How often queued emails are retried automatically (ms). Default 5 minutes.
MAIL_RETRY_INTERVAL_MS=300000
# Give up on an email after this many attempts (default 288 = about 24h at 5 min).
MAIL_MAX_ATTEMPTS=288

# ---------------------------------------------------------------
# Mail outbox page (/mail) - shows every email, its status, and lets you retry.
# Always open in development. In production it needs ?key=<ADMIN_KEY>; leave ADMIN_KEY empty to disable it.
# ---------------------------------------------------------------
ADMIN_KEY=

# Where request records and the mail outbox are stored (must be writable and persistent).
DATA_DIR=./data
